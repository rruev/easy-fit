// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id        String     @id @default(cuid())
    email     String     @unique
    password  String
    createdAt DateTime   @default(now())
    workouts  Workout[]
    exercises Exercise[]
    schedule  Schedule?

    @@map("users")
}

model Workout {
    id         String            @id @default(cuid())
    userId     String
    name       String
    categoryId String
    createdAt  DateTime          @default(now())
    duration   Int
    user       User              @relation(fields: [userId], references: [id])
    scheduled  ScheduleWorkout[]
    exercises  WorkoutExercise[]
    category   WorkoutCategory   @relation(fields: [categoryId], references: [id])

    @@map("workouts")
}

model WorkoutExercise {
    workoutId  String
    exerciseId String
    sets       Int
    reps       Int
    workout    Workout  @relation(fields: [workoutId], references: [id])
    exercise   Exercise @relation(fields: [exerciseId], references: [id])

    @@id([workoutId, exerciseId])
    @@map("workout_exercises")
}

model Exercise {
    id         String           @id @default(cuid())
    userId     String
    categoryId String
    name       String
    createdAt  DateTime         @default(now())
    user       User             @relation(fields: [userId], references: [id])
    workouts   WorkoutExercise[]
    category   ExerciseCategory @relation(fields: [categoryId], references: [id])

    @@map("exercises")
}

model Schedule {
    id        String            @id @default(cuid())
    userId    String            @unique
    name      String
    createdAt DateTime          @default(now())
    workouts  ScheduleWorkout[]
    user      User              @relation(fields: [userId], references: [id])

    @@map("schedules")
}

model ScheduleWorkout {
    scheduleWorkoutId String   @id @default(cuid())
    scheduleId        String
    workoutId         String
    day               Int
    schedule          Schedule @relation(fields: [scheduleId], references: [id])
    workout           Workout  @relation(fields: [workoutId], references: [id])

    @@map("schedule_workouts")
}

model ExerciseCategory {
    id    String @id @default(cuid())
    name  String @unique
    color String

    exercises Exercise[]

    @@map("exercise_categories")
}

model WorkoutCategory {
    id    String @id @default(cuid())
    name  String @unique
    color String

    workouts Workout[]

    @@map("workout_categories")
}
